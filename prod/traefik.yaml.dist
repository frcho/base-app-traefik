global:
  sendAnonymousUsage: false

api:
  dashboard: true
  insecure: true

entryPoints:
  http:
    address: ":80"
  https:
    address: ":443"
  traefik:
    address: ":8080"

ping:
  entryPoint: "http"

metrics:
  prometheus: {}

# static configuration
log:
  level: DEBUG
  filePath: /tmp/traefik.log
  format: common

# Limiting the Logs to Specific Fields
accessLog:
  filePath: /tmp/access.log
  format: json
  fields:
    defaultMode: keep
    names:
      ClientUsername: drop
    headers:
      defaultMode: keep
      names:
        User-Agent: keep
        Authorization: drop
        Content-Type: keep

certificatesResolvers:
  leresolver:
    acme:
      email: [EMAIL_ADDRESS]
      storage: "/etc/traefik/acme/acme.json"
      #If you uncommented the 'caserver' line,
      #you will get an SSL error, but if you display the certificate
      #and see it was emitted by Fake LE Intermediate X1 then it means
      #all is good.
      #(It is the staging environment intermediate certificate used by let's encrypt).
      #You can now safely comment the acme.caserver line, remove the letsencrypt/acme.json
      #file and restart Traefik to issue a valid certificate.
      #***
      #caServer: https://acme-staging-v02.api.letsencrypt.org/directory
      #***
      httpChallenge:
        entryPoint: http
  # dnsresolver:
  #   acme:
  #     email: [EMAIL_ADDRESS]
  #     storage: "/etc/traefik/acme/acme-dns.json"
  #     caServer: "https://acme-v02.api.letsencrypt.org/directory"
  #     dnsChallenge:
  #       provider: route53
  #       delayBeforeCheck: 30
  #       #disablepropagationcheck: true
  #       resolvers:
  #         - 1.1.1.1:53
  #         - 8.8.8.8:53

providers:
  docker:
    endpoint: "tcp://dockerproxy:2375"
    network: "traefik"
    exposedbydefault: false
    watch: true

  file:
    directory: /etc/traefik/conf.d/
    watch: true

experimental:
  plugins:
    traefik-plugin-fail2ban:
      moduleName: "github.com/juitde/traefik-plugin-fail2ban"
      version: "v0.2.0"
    traefik-plugin-blockuseragent:
      moduleName: "github.com/agence-gaya/traefik-plugin-blockuseragent"
      version: "v0.1.7"      
