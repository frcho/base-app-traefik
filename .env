PROJECT_NAME=traefik
DOMAIN_NAME=traefik.localhost
ENVIRONMENT=dev

# Selección de Servicios (Profiles)
# COMPOSE_PROFILES=tools,mail,monitoring
COMPOSE_PROFILES=mail,monitoring

# Configuración dinámica de Traefik (Labels)
# En dev se usan defaults del compose, pero aquí puedes forzarlos:
TRAEFIK_ENTRYPOINTS=http
TRAEFIK_TLS=false
TRAEFIK_CERT_RESOLVER=
TRAEFIK_MIDDLEWARES=

# --- Ejemplo Producción ---
# ENVIRONMENT=prod
# DOMAIN_NAME=midominio.com
# TRAEFIK_ENTRYPOINTS=https
# TRAEFIK_TLS=true
# TRAEFIK_CERT_RESOLVER=leresolver
# TRAEFIK_MIDDLEWARES=redirect-to-https@file